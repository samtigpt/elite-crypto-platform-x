# ECPX Environment Configuration (Template)
# Copy this file to .env and fill in values when implementing later milestones.
# NEVER commit .env to version control.

# --- Application ---
ECPX_ENV=development
ECPX_LOG_LEVEL=INFO

# --- Database (Milestone 2+) ---
# DATABASE_URL=postgresql://ecpx:changeme@localhost:5432/ecpx

# --- Redis (Milestone 2+) ---
# REDIS_URL=redis://localhost:6379/0

# --- Binance (Milestone 1+ — read-only public endpoints only) ---
# No API keys required for public market data.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# --- Alert delivery (Milestone 9+) ---
# EMAIL_PROVIDER=
# EMAIL_FROM=
# EMAIL_API_KEY=

# --- Web dashboard (Milestone 8+) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Daily report schedule ---
ECPX_DAILY_REPORT_UTC=00:15
